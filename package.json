{
  "name": "v0x-0s",
  "private": true,
  "version": "1.1.0",
  "description": "VOX-OS — A Dev's First Choice. A futuristic developer operating environment.",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "server": "node server/index.js",
    "agent": "node agent/index.js",
    "desktop": "npm run build && electron .",
    "dev:all": "node server/index.js & vite",
    "dev:all:win": "start /b node server/index.js && vite",
    "apk:sync": "npm run build && npx cap sync android",
    "apk:build": "npm run build && npx cap sync android && cd android && gradlew assembleDebug",
    "apk:release": "npm run build && npx cap sync android && cd android && gradlew assembleRelease",
    "exe:build": "npm run build && electron-builder --win --x64",
    "test": "vitest run"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/app": "^6.0.3",
    "@capacitor/cli": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "@fontsource/inter": "^5.0.18",
    "@fontsource/jetbrains-mono": "^5.0.20",
    "@fontsource/space-grotesk": "^5.0.19",
    "clsx": "^2.1.1",
    "lucide-react": "^0.441.0",
    "prismjs": "^1.29.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.21.3",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/prismjs": "^1.26.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.3",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.voxos.desktop",
    "productName": "VOX-OS",
    "asar": true,
    "asarUnpack": [
      "agent/**/*",
      "server/**/*"
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "agent/**/*",
      "server/**/*",
      "public/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/vox.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VOX-OS"
    }
  }
}
