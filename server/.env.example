# VOX-OS backend — copy to server/.env and fill in.
# NEVER commit real keys. The frontend never sees these values.

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Groq API key (https://console.groq.com/keys)
GROQ_API_KEY=

# GitHub personal access token (repo + read:user scopes) or use OAuth
GITHUB_TOKEN=

# Backend port (frontend proxies /api to this)
PORT=8787
